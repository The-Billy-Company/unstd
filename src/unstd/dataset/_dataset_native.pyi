"""Private checked dataset offset-copy kernel."""

from collections.abc import Buffer
from typing import overload

KERNEL_VERSION: int

class Mapping:
    """Private owned read-only file mapping with buffer-export lifetime checks."""

    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int, /) -> int: ...
    @overload
    def __getitem__(self, key: slice, /) -> bytes: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
    def __release_buffer__(self, view: memoryview, /) -> None: ...
    def find(self, needle: bytes, start: int, stop: int, /) -> int: ...
    def close(self) -> None: ...

def map(fd: int, /) -> Mapping | None: ...
def row(data: Buffer, index_offset: int, count: int, position: int, /) -> bytes: ...
def take(
    data: Buffer,
    index_offset: int,
    count: int,
    positions: tuple[int, ...],
    /,
) -> list[bytes]: ...
def span(
    data: Buffer, index_offset: int, count: int, start: int, stop: int, /
) -> bytes: ...
def validate(data: Buffer, index_offset: int, count: int, /) -> None: ...
