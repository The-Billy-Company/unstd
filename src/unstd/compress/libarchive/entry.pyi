"""Typed libarchive-c 5.3 interface facts for the native entry boundary."""

from collections.abc import Iterator
from typing import Any, TypedDict, Unpack

from .ffi import _ArchivePointer

type _Timestamp = int | float | tuple[int, int] | None

class _EntryAttributes(TypedDict, total=False):
    pathname: str | bytes
    linkpath: str | bytes
    size: int | None
    filetype: int
    perm: int
    mode: int
    mtime: _Timestamp
    ctime: _Timestamp
    birthtime: _Timestamp

class ArchiveEntry:
    header_codec: str
    def __init__(
        self,
        archive_p: _ArchivePointer | None = None,
        header_codec: str = "utf-8",
        **attributes: Unpack[_EntryAttributes],
    ) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def get_blocks(self, block_size: int = ...) -> Iterator[bytes]: ...
    @property
    def pathname(self) -> str | bytes | None: ...
    @pathname.setter
    def pathname(self, value: str | bytes) -> None: ...
    @property
    def linkpath(self) -> str | bytes | None: ...
    @linkpath.setter
    def linkpath(self, value: str | bytes) -> None: ...
    @property
    def size(self) -> int | None: ...
    @size.setter
    def size(self, value: int | None) -> None: ...
    @property
    def mtime(self) -> int | float | None: ...
    @mtime.setter
    def mtime(self, value: _Timestamp) -> None: ...
    @property
    def ctime(self) -> int | float | None: ...
    @ctime.setter
    def ctime(self, value: _Timestamp) -> None: ...
    @property
    def birthtime(self) -> int | float | None: ...
    @birthtime.setter
    def birthtime(self, value: _Timestamp) -> None: ...
    @property
    def mode(self) -> int: ...
    @mode.setter
    def mode(self, value: int) -> None: ...
    @property
    def isdir(self) -> bool: ...
    @property
    def issym(self) -> bool: ...
    @property
    def islnk(self) -> bool: ...
    @property
    def isreg(self) -> bool: ...

def __getattr__(name: str) -> Any: ...
