Sun Oct 25 11:10:22 PDT 2026
usage:
  configure [--prefix=PREFIX]  [--eprefix=EXPREFIX]
    [--static] [--32] [--64] [--libdir=LIBDIR] [--sharedlibdir=LIBDIR]
    [--includedir=INCLUDEDIR] [--installnamedir="@rpath"] [--mandir=MANDIR] [--archs="-arch i386 -arch x86_64"]
    [--sprefix=SYMBOL_PREFIX]   Adds a prefix to all exported symbols
    [--warn]                    Enables extra compiler warnings
    [--debug]                   Enables extra debug prints during operation
    [--zlib-compat]             Compiles for zlib-compatible API instead of zlib-ng API
    [--without-gzfileops]       Compiles without the gzfile parts of the API enabled
    [--without-optimizations]   Compiles without support for optional instruction sets
    [--without-new-strategies]  Compiles without using new additional deflate strategies
    [--without-vpclmulqdq]      Compiles without x86 VPCLMUL instruction set
    [--without-armv6]           Compiles without ARMv6 SIMD instruction set
    [--without-armv8]           Compiles without ARMv8 CRC32 instruction set
    [--without-neon]            Compiles without ARM Neon SIMD instruction set
    [--without-rvv]             Compiles without RISC-V RVV instruction set
    [--without-zbc]             Compiles without RISC-V ZBC instruction set
    [--without-altivec]         Compiles without PPC AltiVec support
    [--without-power8]          Compiles without Power8 instruction set
    [--without-power9]          Compiles without Power9 instruction set
    [--with-dfltcc-deflate]     Use DEFLATE CONVERSION CALL instruction for compression on IBM Z
    [--with-dfltcc-inflate]     Use DEFLATE CONVERSION CALL instruction for decompression on IBM Z
    [--without-crc32-vx]        Build without vectorized CRC32 on IBM Z
    [--without-crc32-la]        Build without vectorized CRC32 on Loongarch
    [--with-reduced-mem]        Reduced memory usage for special cases (reduces performance)
