      "source": "def _trim(examples: list[TrainExample], cap: int, rng: rand.Generator) -> list[TrainExample]:\n    \"\"\"Deterministically trim a track to its budget (shuffle then cut).\"\"\"\n    if cap <= 0:\n        return []\n    if len(examples) <= cap:\n        return examples\n    shuffled = examples[:]\n    rng.shuffle(shuffled)\n    return shuffled[:cap]\n",
