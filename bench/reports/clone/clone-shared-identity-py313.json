  "harness_source": "from __future__ import annotations\n\nimport copy\nfrom functools import partial\nimport gc\nimport hashlib\nimport json\nfrom pathlib import Path\nimport platform\nimport sys\n\nfrom bench.profiles import clone_cpu as timing\nfrom unstd.clone import _clone_native as native\nfrom unstd.clone import structural\n\n\ndef prior_builtin_deep(source):\n    kind = type(source)\n    if kind in structural._ATOMS:\n        return source\n    if kind is dict or kind is list or kind is tuple:\n        result = native.clone_checked(source)\n        if result is not NotImplemented:\n            return result\n    raise AssertionError('benchmark source must stay on prior native builtin path')\n\n\nshared = list(range(1000))\ncases = {\n    'small-dict': {'id': 7, 'name': 'row', 'active': True},\n    'scalar-list-10000': list(range(10000)),\n    'nested-unique-200': {'rows': [{'id': i, 'items': [i, i+1], 'meta': {'active': True}} for i in range(200)]},\n    'shared-list-1000-repeated-500': [shared] * 500,\n}\nresult = {\n    'python': sys.version,\n    'platform': platform.platform(),\n    'rounds': 9,\n    'gc_enabled_during_batches': False,\n    'includes_output_destruction': True,\n    'baseline': 'prior public builtin fast path, recreated with native.clone_checked and the prior atom/type/result checks; no saved full implementation used',\n    'current': timing._metadata(structural),\n    'harness_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    'harness_source': Path(__file__).read_text(),\n    'workloads': {},\n}\nfor name, source in cases.items():\n    calls = {\n        'current': partial(structural.deep, source),\n        'prior-builtin': partial(prior_builtin_deep, source),\n        'stdlib': partial(copy.deepcopy, source),\n    }\n    for label, call in calls.items():\n        actual = call()\n        assert timing._same(actual, source)\n        assert timing._isolated(actual, source, reuse_tuples=label == 'stdlib')\n        if name.startswith('shared-'):\n            assert (actual[0] is actual[1]) == (label != 'prior-builtin')\n    samples = timing._timings(calls, 9, False)\n    for label, values in samples.items():\n        values['cpu_speedup_vs_prior_builtin'] = samples['prior-builtin']['median_cpu_ns'] / values['median_cpu_ns']\n        values['cpu_speedup_vs_stdlib'] = samples['stdlib']['median_cpu_ns'] / values['median_cpu_ns']\n    result['workloads'][name] = samples\npath = Path('bench/reports/clone/clone-shared-identity-py313.json')\npath.write_text(json.dumps(result, indent=2) + '\\n')\nfor name, samples in result['workloads'].items():\n    current = samples['current']\n    old = samples['prior-builtin']\n    print(f\"{name}: current={current['median_cpu_ns']/1000:.2f}us prior={old['median_cpu_ns']/1000:.2f}us ratio={current['cpu_speedup_vs_prior_builtin']:.2f}x stdlib={current['cpu_speedup_vs_stdlib']:.2f}x\")\n",
