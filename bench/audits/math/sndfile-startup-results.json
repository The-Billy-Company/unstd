  "worker": "import io,json,resource,sys,time,wave\nsys.path.insert(0,sys.argv[1]) if sys.argv[1] else None\ncpu=time.process_time_ns(); wall=time.perf_counter_ns()\nimport unstd.audio.wavx as wavx\nimport soundfile\nimport_wall=time.perf_counter_ns()-wall; import_cpu=time.process_time_ns()-cpu\nstream=io.BytesIO()\nwith wave.open(stream,'wb') as f:\n    f.setnchannels(1);f.setsampwidth(2);f.setframerate(16000);f.writeframes(b'\\0\\0')\nstream.seek(0)\ncpu=time.process_time_ns();wall=time.perf_counter_ns()\nsamples,rate=wavx.read(stream,dtype='int16')\nfirst_wall=time.perf_counter_ns()-wall;first_cpu=time.process_time_ns()-cpu\nassert samples.tolist()==[0] and rate==16000\nprint(json.dumps(dict(import_wall_ns=import_wall,import_cpu_ns=import_cpu,first_read_wall_ns=first_wall,first_read_cpu_ns=first_cpu,peak_rss_bytes=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,library=soundfile._full_path)))\n",
